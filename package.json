{
  "name": "react-tut",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "set -a && . ./.env.local && set +a && vite",
    "build": "prisma generate && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:push": "set -a && . ./.env.local && set +a && prisma db push",
    "db:pull": "set -a && . ./.env.local && set +a && prisma db pull",
    "db:generate": "set -a && . ./.env.local && set +a && prisma generate",
    "db:seed": "set -a && . ./.env.local && set +a && node prisma/seed.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.115.0",
    "@tailwindcss/vite": "^4.1.17",
    "@tanstack/react-query": "^5.102.8",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "country-state-city": "^3.2.1",
    "csv-parse": "^7.0.2",
    "framer-motion": "^12.33.0",
    "prisma": "^6.19.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-phone-number-input": "^3.4.18",
    "react-router-dom": "^7.9.5",
    "resend": "^6.26.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "tailwindcss": "^4.1.17",
    "vite": "^7.1.7",
    "vitest": "^5.0.1"
  }
}
