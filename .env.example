# Supabase Postgres connection strings for Prisma.
# Runtime queries use the pooled URL on port 6543. Prisma CLI migrations and
# schema pushes use the direct URL on port 5432.
DATABASE_URL="postgresql://postgres:<password>@<project-ref>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<password>@<project-ref>.pooler.supabase.com:5432/postgres"

# Browser Supabase client (safe to expose — anon key is RLS-gated).
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon-key>"

# Server-only (src/server/*, never bundled to the browser). Required for
# /api/me and /api/admin/* to verify sessions and check Prisma roles.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Server-only Cloudinary credentials for image and CSV-related uploads.
CLOUDINARY_CLOUD_NAME="<cloudinary-cloud-name>"
CLOUDINARY_API_KEY="<cloudinary-api-key>"
CLOUDINARY_URL="cloudinary://<api-key>:<api-secret>@<cloudinary-cloud-name>"
CLOUDINARY_API_SECRET="<cloudinary-api-secret>"

# Server-only payment credentials.
PAYSTACK_SECRET_KEY="<paystack-secret-key>"

# --- Transactional + promotional email (Resend) ------------------------
# Every customer-facing email goes through Resend: order confirmations,
# payment receipts, shipping and delivery notices, support replies and
# promotional campaigns.
#
# RESEND_FROM_EMAIL must use a domain verified in the Resend dashboard.
# Until it is, Resend will only deliver to the account owner's own address
# and everything else is silently dropped.
RESEND_API_KEY="<resend-api-key>"
RESEND_FROM_EMAIL="GRV <support@grvhq.com>"
# Where new-order alerts for the shop owner are sent.
ADMIN_ALERT_EMAIL="admin@example.com"

# Vercel Cron authenticates GET /api/admin/reminders/run with this secret.
# That job now runs hourly (vercel.json) and does three things: abandoned
# cart and wishlist reminders, retrying order emails the provider rejected,
# and sending scheduled promotional campaigns. Hourly crons require a Vercel
# Pro plan; on Hobby the schedule must stay daily, which caps campaign
# scheduling granularity at once a day.
CRON_SECRET="<vercel-cron-secret>"

# Public site URL used in reminder email links.
APP_URL="https://<your-vercel-domain>"

# Optional test-only failure switch for restock notification flows.
SIMULATE_RESTOCK_NOTIFICATION_FAILURE=""

# Per-purpose senders (all at the verified Resend domain). Each falls back to
# RESEND_FROM_EMAIL if unset. See src/server/emailSenders.js for which email
# uses which.
RESEND_FROM_INFO="GRV <info@grvhq.com>"
RESEND_FROM_NOREPLY="GRV <noreply@grvhq.com>"
RESEND_FROM_SUPPORT="GRV Support <support@grvhq.com>"
# A mailbox that actually RECEIVES mail; used as Reply-To on order and brand
# emails. Sending from a domain does not create an inbox for it.
SUPPORT_INBOX_EMAIL="support@grvhq.com"

# Error tracking. VITE_ is public (shipped to the browser); the token is
# build-time only and must never be exposed.
VITE_SENTRY_DSN=""
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Google Analytics 4 measurement id (public).
VITE_GA_MEASUREMENT_ID=""

# Google Analytics 4 Data API (powers the "Google Analytics" panel in
# Admin → Visitors). Server-only: never prefix with VITE_.
#   GA4_PROPERTY_ID  — the numeric Property ID (GA → Admin → Property details),
#                      not the G-XXXX measurement id.
#   GA4_CLIENT_EMAIL / GA4_PRIVATE_KEY — from a Google Cloud service-account JSON
#                      key. In GA → Admin → Property access management, add the
#                      service-account email with the "Viewer" role.
GA4_PROPERTY_ID=""
GA4_CLIENT_EMAIL=""
GA4_PRIVATE_KEY=""
