# Supabase Postgres connection strings for Prisma.
# Runtime queries use the pooled URL on port 6543. Prisma CLI migrations and
# schema pushes use the direct URL on port 5432.
DATABASE_URL="postgresql://postgres:<password>@<project-ref>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:<password>@<project-ref>.pooler.supabase.com:5432/postgres"

# Browser Supabase client (safe to expose — anon key is RLS-gated).
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_ANON_KEY="<anon-key>"

# Server-only (src/server/*, never bundled to the browser). Required for
# /api/me and /api/admin/* to verify sessions and check Prisma roles.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# Server-only Cloudinary credentials for image and CSV-related uploads.
CLOUDINARY_CLOUD_NAME="<cloudinary-cloud-name>"
CLOUDINARY_API_KEY="<cloudinary-api-key>"
CLOUDINARY_URL="cloudinary://<api-key>:<api-secret>@<cloudinary-cloud-name>"
CLOUDINARY_API_SECRET="<cloudinary-api-secret>"

# Server-only payment, email, and alerting credentials.
PAYSTACK_SECRET_KEY="<paystack-secret-key>"
RESEND_API_KEY="<resend-api-key>"
ADMIN_ALERT_EMAIL="admin@example.com"

# Vercel Cron authenticates GET /api/admin/reminders/run with this secret.
CRON_SECRET="<vercel-cron-secret>"

# Public site URL used in reminder email links.
APP_URL="https://<your-vercel-domain>"

# Optional test-only failure switch for restock notification flows.
SIMULATE_RESTOCK_NOTIFICATION_FAILURE=""
