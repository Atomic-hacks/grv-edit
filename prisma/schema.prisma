generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                  @id @db.Uuid
  email                   String                  @unique
  name                    String?
  role                    Role                    @default(CUSTOMER)
  active                  Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  orders                  Order[]
  wishlists               Wishlist[]
  waitlistEntries         WaitlistEntry[]
  notifications           Notification[]
  savedAddresses          SavedAddress[]
  carts                   Cart[]
  emailVerified           Boolean                 @default(false)
  hasSeenFirstOrderBanner Boolean                 @default(false)
  firstOrderPromoUsed     Boolean                 @default(false)
  verificationCodes       EmailVerificationCode[]

  // Promotional consent. Separate from transactional email, which is always
  // sent when an order or support thread requires it.
  marketingOptIn   Boolean   @default(false)
  marketingOptInAt DateTime?
  // Stable per-user secret used by one-click unsubscribe links.
  unsubscribeToken String?   @unique
}

model FirstOrderPromo {
  id              String   @id @default(cuid())
  discountPercent Float
  freeShipping    Boolean  @default(false)
  active          Boolean  @default(true)
  bannerMessage   String
  updatedAt       DateTime @updatedAt
}

model ShippingFee {
  id     String @id @default(cuid())
  region String @unique
  fee    Float
}

model EmailVerificationCode {
  id        String    @id @default(cuid())
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

model SavedAddress {
  id         String   @id @default(cuid())
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  label      String
  fullName   String
  country    String   @default("")
  phone      String
  address    String
  city       String
  state      String
  postalCode String   @default("")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Cart {
  id                    String     @id @default(cuid())
  userId                String     @unique @db.Uuid
  user                  User       @relation(fields: [userId], references: [id])
  items                 CartItem[]
  updatedAt             DateTime   @updatedAt
  abandonedReminderSent Boolean    @default(false)
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  cart      Cart   @relation(fields: [cartId], references: [id])
  productId String
  variantId String
  quantity  Int
}

model Order {
  id                        String            @id @default(cuid())
  userId                    String            @db.Uuid
  user                      User              @relation(fields: [userId], references: [id])
  status                    OrderStatus       @default(PENDING)
  total                     Float
  discountId                String?
  discountAmount            Float             @default(0)
  firstOrderDiscountPercent Float?
  firstOrderDiscountAmount  Float             @default(0)
  firstOrderFreeShipping    Boolean           @default(false)
  shippingFee               Float             @default(0)
  shippingAmount            Float             @default(0)
  discount                  Discount?         @relation(fields: [discountId], references: [id], onDelete: SetNull)
  paystackReference         String            @unique
  fullName                  String
  country                   String            @default("")
  phone                     String
  address                   String
  city                      String
  state                     String
  postalCode                String            @default("")
  items                     OrderItem[]
  emailEvents               OrderEmailEvent[]
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
}

// One row per (order, email type). The unique constraint is the dedupe
// mechanism: an admin toggling a status back and forth, a webhook retry and
// a client verification racing each other all try to insert the same row,
// and only the first one wins. `sentAt` stays null until the provider
// actually accepts the message, so a failed send can be retried by the cron
// without ever sending twice.
model OrderEmailEvent {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      OrderEmailType
  sentAt    DateTime?
  attempts  Int            @default(0)
  lastError String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([orderId, type])
  @@index([sentAt])
}

enum OrderEmailType {
  ORDER_CREATED
  ORDER_PAID
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
}

model Discount {
  id        String       @id @default(cuid())
  code      String       @unique
  type      DiscountType
  value     Float
  active    Boolean      @default(true)
  expiresAt DateTime?
  maxUses   Int?
  usedCount Int          @default(0)
  orders    Order[]
}

// Sliding-window rate limiting for the storefront's public, unauthenticated
// write endpoints (contact form, newsletter signup). One row per hit;
// `checkRateLimit` counts rows for a key within the window and prunes old
// ones opportunistically, so this table never needs its own cleanup job.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model SiteImage {
  id        String   @id @default(cuid())
  key       String   @unique
  imageUrl  String
  updatedAt DateTime @updatedAt
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id              String @id @default(cuid())
  orderId         String
  order           Order  @relation(fields: [orderId], references: [id])
  productId       String
  variantId       String
  quantity        Int
  priceAtPurchase Float
}

// A row favorites either a product or a brand, never both — productId and
// brandId are each nullable so the same table covers "save this bag" and
// "follow this label" without two parallel tables. Postgres treats NULL as
// distinct in a unique index, so many brand-favorite rows (productId null)
// coexist fine under the product unique constraint, and vice versa.
model Wishlist {
  id           String   @id @default(cuid())
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id])
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
  brandId      String?
  brand        Brand?   @relation(fields: [brandId], references: [id])
  createdAt    DateTime @default(now())
  reminderSent Boolean  @default(false)

  @@unique([userId, productId])
  @@unique([userId, brandId])
}

model WaitlistEntry {
  id        String         @id @default(cuid())
  userId    String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id])
  variantId String
  variant   Variant        @relation(fields: [variantId], references: [id])
  status    WaitlistStatus @default(WAITING)
  createdAt DateTime       @default(now())

  @@unique([userId, variantId])
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  FULFILLED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id])
  productId String
  type      NotificationType
  message   String
  sent      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

enum NotificationType {
  WISHLIST_SALE
  WISHLIST_LOW_STOCK
  WAITLIST_RESTOCK
}

model JournalPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Reply state. `repliedAt` is only set once the provider has accepted the
  // email, so the dashboard never shows "replied" for a message that failed
  // to send.
  replyBody String?
  repliedAt DateTime?
  repliedBy String?
}

model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  createdAt        DateTime  @default(now())
  unsubscribedAt   DateTime?
  unsubscribeToken String?   @unique
}

// Promotional email. Deliberately separate from the transactional order
// emails above: different consent rules, different sending path, and a
// campaign that fails must never be able to report itself as sent.
model Campaign {
  id                 String           @id @default(cuid())
  subject            String
  preheader          String?
  body               String
  imageUrl           String?
  ctaLabel           String?
  ctaUrl             String?
  featuredProductIds String[]         @default([])
  audience           CampaignAudience @default(CUSTOMERS)
  status             CampaignStatus   @default(DRAFT)
  scheduledFor       DateTime?
  startedAt          DateTime?
  sentAt             DateTime?
  recipientCount     Int              @default(0)
  sentCount          Int              @default(0)
  failedCount        Int              @default(0)
  lastError          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status, scheduledFor])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
  FAILED
}

enum CampaignAudience {
  CUSTOMERS
  NEWSLETTER
  ALL
}

model Brand {
  id          String     @id
  name        String
  slug        String     @unique
  logo        String?
  description String?
  products    Product[]
  wishlists   Wishlist[]
}

// One self-referencing tree, arbitrarily deep — everything that used to be
// Category / gender department / Section lives here. A row with no parent
// is a "major category" (what can appear in navigation — Women, Men,
// Accessories, Footwear, Jewelry, Lifestyle, anything an admin invents
// later). A row with a parent nests under it, and that row can itself have
// children (Men > Accessories > Jewelry), as deep as an admin wants to go.
// The nav/homepage fields are optional on every row, which is what lets
// "Lifestyle" or a seasonal drop be nothing more than a major category
// that also happens to be featured — no separate Section model to keep in
// sync with this one.
model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryTree")

  showInNav      Boolean @default(false)
  navOrder       Int     @default(0)
  description    String?
  showOnHomepage Boolean @default(false)
  homepageOrder  Int?

  products  ProductCategory[]
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now()) @updatedAt

  @@index([parentId])
}

// A product's membership in the tree. Tagging a product with a subcategory
// (Accessories > Bags) is enough — browsing the parent (Accessories) walks
// the tree and picks up its descendants automatically, so a product never
// needs a separate link to both.
model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

// Filters kept deliberately simple: brand and price are structured fields
// already, color reads off the variant, and Style/Mood/Occasion/Weather are
// all the same shape (a named tag under a named dimension) so they share
// one small model instead of four bespoke ones.
model FilterType {
  id   String @id @default(cuid())
  name String
  slug String @unique
  tags Tag[]
}

model Tag {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  filterTypeId String
  filterType   FilterType   @relation(fields: [filterTypeId], references: [id])
  products     ProductTag[]
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id])
  tag       Tag     @relation(fields: [tagId], references: [id])

  @@id([productId, tagId])
}

model Product {
  id              String            @id
  name            String
  description     String
  basePrice       Float
  discountPercent Float?
  status          ProductStatus     @default(ACTIVE)
  createdAt       DateTime          @default(now())
  imageUrl        String?
  // Editorial pick, toggled by hand — unlike "new," this is a deliberate
  // curatorial call, so it stays a plain flag rather than a tree membership.
  featured        Boolean           @default(false)
  archived        Boolean           @default(false)
  brandId         String
  brand           Brand             @relation(fields: [brandId], references: [id])
  categories      ProductCategory[]
  variants        Variant[]
  tags            ProductTag[]
  wishlists       Wishlist[]

  @@index([brandId])
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

model Variant {
  id              String          @id
  color           String
  size            String
  stock           Int             @default(10)
  sku             String          @unique
  images          String[]
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  waitlistEntries WaitlistEntry[]

  @@index([productId])
}

enum Role {
  CUSTOMER
  ADMIN
}
