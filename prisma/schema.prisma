generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                  @id @db.Uuid
  email                   String                  @unique
  name                    String?
  role                    Role                    @default(CUSTOMER)
  active                  Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  orders                  Order[]
  wishlists               Wishlist[]
  waitlistEntries         WaitlistEntry[]
  notifications           Notification[]
  savedAddresses          SavedAddress[]
  carts                   Cart[]
  emailVerified           Boolean                 @default(false)
  hasSeenFirstOrderBanner Boolean                 @default(false)
  firstOrderPromoUsed     Boolean                 @default(false)
  verificationCodes       EmailVerificationCode[]

  // Promotional consent. Separate from transactional email, which is always
  // sent when an order or support thread requires it.
  marketingOptIn   Boolean   @default(false)
  marketingOptInAt DateTime?
  // Stable per-user secret used by one-click unsubscribe links.
  unsubscribeToken String?   @unique
}

model FirstOrderPromo {
  id              String   @id @default(cuid())
  discountPercent Float
  freeShipping    Boolean  @default(false)
  active          Boolean  @default(true)
  bannerMessage   String
  updatedAt       DateTime @updatedAt
}

model ShippingFee {
  id     String @id @default(cuid())
  region String @unique
  fee    Float
}

model EmailVerificationCode {
  id        String    @id @default(cuid())
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

model SavedAddress {
  id         String   @id @default(cuid())
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  label      String
  fullName   String
  country    String   @default("")
  phone      String
  address    String
  city       String
  state      String
  postalCode String   @default("")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Cart {
  id                    String     @id @default(cuid())
  userId                String     @unique @db.Uuid
  user                  User       @relation(fields: [userId], references: [id])
  items                 CartItem[]
  updatedAt             DateTime   @updatedAt
  abandonedReminderSent Boolean    @default(false)
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  cart      Cart   @relation(fields: [cartId], references: [id])
  productId String
  variantId String
  quantity  Int
}

model Order {
  id                        String            @id @default(cuid())
  userId                    String            @db.Uuid
  user                      User              @relation(fields: [userId], references: [id])
  status                    OrderStatus       @default(PENDING)
  total                     Float
  discountId                String?
  discountAmount            Float             @default(0)
  firstOrderDiscountPercent Float?
  firstOrderDiscountAmount  Float             @default(0)
  firstOrderFreeShipping    Boolean           @default(false)
  shippingFee               Float             @default(0)
  shippingAmount            Float             @default(0)
  discount                  Discount?         @relation(fields: [discountId], references: [id], onDelete: SetNull)
  paystackReference         String            @unique
  fullName                  String
  country                   String            @default("")
  phone                     String
  address                   String
  city                      String
  state                     String
  postalCode                String            @default("")
  items                     OrderItem[]
  emailEvents               OrderEmailEvent[]
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
}

// One row per (order, email type). The unique constraint is the dedupe
// mechanism: an admin toggling a status back and forth, a webhook retry and
// a client verification racing each other all try to insert the same row,
// and only the first one wins. `sentAt` stays null until the provider
// actually accepts the message, so a failed send can be retried by the cron
// without ever sending twice.
model OrderEmailEvent {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      OrderEmailType
  sentAt    DateTime?
  attempts  Int            @default(0)
  lastError String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([orderId, type])
  @@index([sentAt])
}

enum OrderEmailType {
  ORDER_CREATED
  ORDER_PAID
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
}

model Discount {
  id        String       @id @default(cuid())
  code      String       @unique
  type      DiscountType
  value     Float
  active    Boolean      @default(true)
  expiresAt DateTime?
  maxUses   Int?
  usedCount Int          @default(0)
  orders    Order[]
}

model SiteImage {
  id        String   @id @default(cuid())
  key       String   @unique
  imageUrl  String
  updatedAt DateTime @updatedAt
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id              String @id @default(cuid())
  orderId         String
  order           Order  @relation(fields: [orderId], references: [id])
  productId       String
  variantId       String
  quantity        Int
  priceAtPurchase Float
}

model Wishlist {
  id           String   @id @default(cuid())
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id])
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  createdAt    DateTime @default(now())
  reminderSent Boolean  @default(false)

  @@unique([userId, productId])
}

model WaitlistEntry {
  id        String         @id @default(cuid())
  userId    String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id])
  variantId String
  variant   Variant        @relation(fields: [variantId], references: [id])
  status    WaitlistStatus @default(WAITING)
  createdAt DateTime       @default(now())

  @@unique([userId, variantId])
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  FULFILLED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id])
  productId String
  type      NotificationType
  message   String
  sent      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

enum NotificationType {
  WISHLIST_SALE
  WISHLIST_LOW_STOCK
  WAITLIST_RESTOCK
}

model JournalPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Reply state. `repliedAt` is only set once the provider has accepted the
  // email, so the dashboard never shows "replied" for a message that failed
  // to send.
  replyBody String?
  repliedAt DateTime?
  repliedBy String?
}

model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  createdAt        DateTime  @default(now())
  unsubscribedAt   DateTime?
  unsubscribeToken String?   @unique
}

// Promotional email. Deliberately separate from the transactional order
// emails above: different consent rules, different sending path, and a
// campaign that fails must never be able to report itself as sent.
model Campaign {
  id                 String           @id @default(cuid())
  subject            String
  preheader          String?
  body               String
  imageUrl           String?
  ctaLabel           String?
  ctaUrl             String?
  featuredProductIds String[]         @default([])
  audience           CampaignAudience @default(CUSTOMERS)
  status             CampaignStatus   @default(DRAFT)
  scheduledFor       DateTime?
  startedAt          DateTime?
  sentAt             DateTime?
  recipientCount     Int              @default(0)
  sentCount          Int              @default(0)
  failedCount        Int              @default(0)
  lastError          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status, scheduledFor])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
  FAILED
}

enum CampaignAudience {
  CUSTOMERS
  NEWSLETTER
  ALL
}

model Brand {
  id          String    @id
  name        String
  slug        String    @unique
  logo        String?
  description String?
  products    Product[]
}

model Category {
  id            String               @id
  name          String
  styleTags     CategoryStyleTag[]
  filterTypes   CategoryFilterType[]
  subcategories Subcategory[]
  products      Product[]
}

model FilterType {
  id         String               @id @default(cuid())
  name       String
  slug       String               @unique
  tags       Tag[]
  categories CategoryFilterType[]
}

model CategoryFilterType {
  categoryId   String
  filterTypeId String
  category     Category   @relation(fields: [categoryId], references: [id])
  filterType   FilterType @relation(fields: [filterTypeId], references: [id])

  @@id([categoryId, filterTypeId])
}

model CategoryStyleTag {
  id         String    @id
  name       String
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  products   Product[] @relation("CategoryStyleTagToProduct")

  @@unique([categoryId, name])
}

model Subcategory {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  categoryId String
  category   Category  @relation(fields: [categoryId], references: [id])
  products   Product[]
}

model Tag {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  filterTypeId String
  filterType   FilterType   @relation(fields: [filterTypeId], references: [id])
  products     ProductTag[]
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id])
  tag       Tag     @relation(fields: [tagId], references: [id])

  @@id([productId, tagId])
}

model Section {
  id             String           @id @default(cuid())
  title          String
  slug           String           @unique
  description    String
  showOnHomepage Boolean          @default(false)
  homepageOrder  Int?
  products       ProductSection[]
  createdAt      DateTime         @default(now())
}

model ProductSection {
  productId String
  sectionId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  section   Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([productId, sectionId])
}

model Product {
  id              String             @id
  name            String
  gender          Gender
  categoryId      String
  subcategory     String
  subcategoryId   String?
  description     String
  basePrice       Float
  discountPercent Float?
  status          ProductStatus      @default(ACTIVE)
  createdAt       DateTime           @default(now())
  imageUrl        String?
  isNew           Boolean            @default(false)
  archived        Boolean            @default(false)
  brandId         String
  brand           Brand              @relation(fields: [brandId], references: [id])
  category        Category           @relation(fields: [categoryId], references: [id])
  subcategoryRef  Subcategory?       @relation(fields: [subcategoryId], references: [id])
  variants        Variant[]
  tags            ProductTag[]
  sections        ProductSection[]
  wishlists       Wishlist[]
  styleTags       CategoryStyleTag[] @relation("CategoryStyleTagToProduct")

  @@index([gender])
  @@index([categoryId])
  @@index([subcategory])
  @@index([subcategoryId])
  @@index([brandId])
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

model Variant {
  id              String          @id
  color           String
  size            String
  stock           Int             @default(10)
  sku             String          @unique
  images          String[]
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  waitlistEntries WaitlistEntry[]

  @@index([productId])
}

enum Gender {
  men
  women
  unisex
  kids
}

enum Role {
  CUSTOMER
  ADMIN
}
