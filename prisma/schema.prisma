generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                  @id @db.Uuid
  email                   String                  @unique
  name                    String?
  role                    Role                    @default(CUSTOMER)
  active                  Boolean                 @default(true)
  createdAt               DateTime                @default(now())
  orders                  Order[]
  wishlists               Wishlist[]
  waitlistEntries         WaitlistEntry[]
  notifications           Notification[]
  savedAddresses          SavedAddress[]
  carts                   Cart[]
  emailVerified           Boolean                 @default(false)
  hasSeenFirstOrderBanner Boolean                 @default(false)
  firstOrderPromoUsed     Boolean                 @default(false)
  verificationCodes       EmailVerificationCode[]

  // Promotional consent. Separate from transactional email, which is always
  // sent when an order or support thread requires it.
  marketingOptIn   Boolean   @default(false)
  marketingOptInAt DateTime?
  // Stable per-user secret used by one-click unsubscribe links.
  unsubscribeToken String?   @unique

  supportCases SupportCase[]
  caseNotes    CaseNote[]
  caseEvents   CaseEvent[]
  adminActions AdminAuditLog[]
}

model FirstOrderPromo {
  id              String   @id @default(cuid())
  discountPercent Float
  freeShipping    Boolean  @default(false)
  active          Boolean  @default(true)
  bannerMessage   String
  updatedAt       DateTime @updatedAt
}

model ShippingFee {
  id     String @id @default(cuid())
  region String @unique
  fee    Float
}

model EmailVerificationCode {
  id        String    @id @default(cuid())
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
}

model SavedAddress {
  id         String   @id @default(cuid())
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  label      String
  fullName   String
  country    String   @default("")
  phone      String
  address    String
  city       String
  state      String
  postalCode String   @default("")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Cart {
  id                    String     @id @default(cuid())
  userId                String     @unique @db.Uuid
  user                  User       @relation(fields: [userId], references: [id])
  items                 CartItem[]
  updatedAt             DateTime   @updatedAt
  abandonedReminderSent Boolean    @default(false)
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  cart      Cart   @relation(fields: [cartId], references: [id])
  productId String
  variantId String
  quantity  Int
}

model Order {
  id                        String            @id @default(cuid())
  userId                    String            @db.Uuid
  user                      User              @relation(fields: [userId], references: [id])
  status                    OrderStatus       @default(PENDING)
  total                     Float
  discountId                String?
  discountAmount            Float             @default(0)
  firstOrderDiscountPercent Float?
  firstOrderDiscountAmount  Float             @default(0)
  firstOrderFreeShipping    Boolean           @default(false)
  shippingFee               Float             @default(0)
  shippingAmount            Float             @default(0)
  discount                  Discount?         @relation(fields: [discountId], references: [id], onDelete: SetNull)
  paystackReference         String            @unique
  fullName                  String
  country                   String            @default("")
  phone                     String
  address                   String
  city                      String
  state                     String
  postalCode                String            @default("")
  items                     OrderItem[]
  emailEvents               OrderEmailEvent[]
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  // Manual (pre-courier-API) fulfilment tracking. `fulfillmentStatus` is a
  // separate lifecycle from `status` above: `status` is the payment/order
  // lifecycle emails and stock already key off, `fulfillmentStatus` is the
  // shipping/delivery lifecycle the customer sees on the tracking timeline.
  // Keeping them separate means adding real courier statuses later never
  // touches the payment state machine.
  fulfillmentStatus     FulfillmentStatus       @default(PLACED)
  courierName           String?
  trackingNumber        String?
  trackingUrl           String?
  shippingDate          DateTime?
  estimatedDeliveryDate DateTime?
  deliveryNotes         String?
  fulfillmentEvents     OrderFulfillmentEvent[]
  supportCases          SupportCase[]

  @@index([userId])
}

// A checkout attempt in flight. Created the moment Paystack is initialized;
// consumed (deleted) in the same transaction that creates the real Order,
// the instant payment is confirmed. A row that's never claimed — a decline,
// an abandoned tab, a retry after failure — is the only trace a failed
// attempt leaves, and it's swept by a cron a few hours later. There is
// deliberately no "pending order" a customer, or anyone else, could ever
// see: nothing is written to the Order table until money has moved.
model PendingCheckout {
  reference String   @id
  userId    String   @db.Uuid
  payload   Json
  createdAt DateTime @default(now())

  @@index([userId])
}

enum FulfillmentStatus {
  PLACED
  PAYMENT_CONFIRMED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  CANCELLED
  RETURNED
}

// One row per fulfilment status change — the chronological timeline shown
// to both the customer (order tracking) and admin (case/order history).
model OrderFulfillmentEvent {
  id        String            @id @default(cuid())
  orderId   String
  order     Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    FulfillmentStatus
  note      String?
  createdAt DateTime          @default(now())

  @@index([orderId, createdAt])
}

// One row per (order, email type). The unique constraint is the dedupe
// mechanism: an admin toggling a status back and forth, a webhook retry and
// a client verification racing each other all try to insert the same row,
// and only the first one wins. `sentAt` stays null until the provider
// actually accepts the message, so a failed send can be retried by the cron
// without ever sending twice.
model OrderEmailEvent {
  id        String         @id @default(cuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      OrderEmailType
  // Only set for BRAND_ORDER (one notification per brand per order). "" for
  // every customer-facing email — deliberately not NULL, because Postgres
  // treats NULLs as distinct in a unique index and that would silently
  // break the once-per-(order, type) guarantee below.
  brandId   String         @default("")
  sentAt    DateTime?
  attempts  Int            @default(0)
  lastError String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([orderId, type, brandId])
  @@index([sentAt])
}

enum OrderEmailType {
  ORDER_CREATED
  ORDER_PAID
  ORDER_SHIPPED
  ORDER_DELIVERED
  ORDER_CANCELLED
  // Operational notice to a brand's own inbox — not customer-facing.
  BRAND_ORDER
}

model Discount {
  id        String       @id @default(cuid())
  code      String       @unique
  type      DiscountType
  value     Float
  active    Boolean      @default(true)
  expiresAt DateTime?
  maxUses   Int?
  usedCount Int          @default(0)
  orders    Order[]
}

// Sliding-window rate limiting for the storefront's public, unauthenticated
// write endpoints (contact form, newsletter signup). One row per hit;
// `checkRateLimit` counts rows for a key within the window and prunes old
// ones opportunistically, so this table never needs its own cleanup job.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

// One row per page view, written by our own /api/track endpoint so the admin
// Visitors dashboard works without the Google Analytics API. visitorId is a
// random id kept in the browser (no cookies, no IP stored); userId is set
// only while someone is signed in. Pruned after ~180 days.
model SiteVisit {
  id          String   @id @default(cuid())
  visitorId   String
  userId      String?  @db.Uuid
  path        String
  referrer    String?
  device      String?
  country     String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([visitorId, createdAt])
  @@index([userId, createdAt])
}

model SiteImage {
  id        String   @id @default(cuid())
  key       String   @unique
  imageUrl  String
  updatedAt DateTime @updatedAt
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  SHIPPED
  DELIVERED
  CANCELLED
}

model OrderItem {
  id              String @id @default(cuid())
  orderId         String
  order           Order  @relation(fields: [orderId], references: [id])
  productId       String
  variantId       String
  quantity        Int
  priceAtPurchase Float
}

// A row favorites either a product or a brand, never both — productId and
// brandId are each nullable so the same table covers "save this bag" and
// "follow this label" without two parallel tables. Postgres treats NULL as
// distinct in a unique index, so many brand-favorite rows (productId null)
// coexist fine under the product unique constraint, and vice versa.
model Wishlist {
  id           String   @id @default(cuid())
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id])
  productId    String?
  product      Product? @relation(fields: [productId], references: [id])
  brandId      String?
  brand        Brand?   @relation(fields: [brandId], references: [id])
  createdAt    DateTime @default(now())
  reminderSent Boolean  @default(false)

  @@unique([userId, productId])
  @@unique([userId, brandId])
}

model WaitlistEntry {
  id        String         @id @default(cuid())
  userId    String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id])
  variantId String
  variant   Variant        @relation(fields: [variantId], references: [id])
  status    WaitlistStatus @default(WAITING)
  createdAt DateTime       @default(now())

  @@unique([userId, variantId])
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  FULFILLED
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id])
  productId String
  type      NotificationType
  message   String
  sent      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

enum NotificationType {
  WISHLIST_SALE
  WISHLIST_LOW_STOCK
  WAITLIST_RESTOCK
  BRAND_FEATURED_PRODUCT
}

model JournalPost {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  coverImage  String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  // Reply state. `repliedAt` is only set once the provider has accepted the
  // email, so the dashboard never shows "replied" for a message that failed
  // to send.
  replyBody String?
  repliedAt DateTime?
  repliedBy String?
}

model NewsletterSubscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  createdAt        DateTime  @default(now())
  unsubscribedAt   DateTime?
  unsubscribeToken String?   @unique
}

// Promotional email. Deliberately separate from the transactional order
// emails above: different consent rules, different sending path, and a
// campaign that fails must never be able to report itself as sent.
model Campaign {
  id                 String           @id @default(cuid())
  subject            String
  preheader          String?
  body               String
  imageUrl           String?
  ctaLabel           String?
  ctaUrl             String?
  featuredProductIds String[]         @default([])
  audience           CampaignAudience @default(CUSTOMERS)
  status             CampaignStatus   @default(DRAFT)
  scheduledFor       DateTime?
  startedAt          DateTime?
  sentAt             DateTime?
  recipientCount     Int              @default(0)
  sentCount          Int              @default(0)
  failedCount        Int              @default(0)
  lastError          String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status, scheduledFor])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  CANCELLED
  FAILED
}

enum CampaignAudience {
  CUSTOMERS
  NEWSLETTER
  ALL
}

// A brand only ever supplies *recipient* details — where brand-specific
// operational email should go. Every email still sends from a GRV address
// with platform-level credentials (see src/server/emailSenders.js); a brand
// can never change the sender or reach the email provider configuration.
model Brand {
  id                        String           @id
  name                      String
  slug                      String           @unique
  logo                      String?
  description               String?
  contactEmail              String?
  // Email the brand when a paid order contains its products.
  orderNotificationsEnabled Boolean          @default(false)
  products                  Product[]
  wishlists                 Wishlist[]
  contentSections           ContentSection[]
}

// One self-referencing tree, arbitrarily deep — everything that used to be
// Category / gender department / Section lives here. A row with no parent
// is a "major category" (what can appear in navigation — Women, Men,
// Accessories, Footwear, Jewelry, Lifestyle, anything an admin invents
// later). A row with a parent nests under it, and that row can itself have
// children (Men > Accessories > Jewelry), as deep as an admin wants to go.
// The nav/homepage fields are optional on every row, which is what lets
// "Lifestyle" or a seasonal drop be nothing more than a major category
// that also happens to be featured — no separate Section model to keep in
// sync with this one.
model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryTree")

  showInNav      Boolean @default(false)
  navOrder       Int     @default(0)
  description    String?
  showOnHomepage Boolean @default(false)
  homepageOrder  Int?

  products  ProductCategory[]
  // Sections shown on this category's own landing page, and PRODUCTS
  // sections elsewhere that pull their products from this category.
  landingSections ContentSection[] @relation("CategoryLandingSections")
  sourcedSections ContentSection[] @relation("ContentSectionSourceCategory")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @default(now()) @updatedAt

  @@index([parentId])
}

// A product's membership in the tree. Tagging a product with a subcategory
// (Accessories > Bags) is enough — browsing the parent (Accessories) walks
// the tree and picks up its descendants automatically, so a product never
// needs a separate link to both.
model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

// Filters kept deliberately simple: brand and price are structured fields
// already, color reads off the variant, and Style/Mood/Occasion/Weather are
// all the same shape (a named tag under a named dimension) so they share
// one small model instead of four bespoke ones.
// Every editable block on the Home, Shop, Departments and category landing
// pages — one generic model rather than a table per section. `layout`
// decides how it renders; fields a layout doesn't use are simply ignored.
enum ContentPage {
  HOME
  SHOP
  DEPARTMENTS
  CATEGORY
}

enum ContentLayout {
  HERO // full-bleed image/video with title, description and CTA
  BANNER // wide media block with text and CTA
  TILES // grid of linked image tiles (items)
  BENTO // asymmetric collage of linked image tiles (items)
  PRODUCTS // product rail fed by productSource
  BRANDS // grid of every brand, maintained automatically
}

enum ContentMediaType {
  IMAGE
  VIDEO
}

enum ContentProductSource {
  NEW_ARRIVALS
  FEATURED
  CATEGORY
  BRAND
}

model ContentSection {
  id          String           @id @default(cuid())
  page        ContentPage
  // Only for page = CATEGORY: which category's landing page this is on.
  categoryId  String?
  category    Category?        @relation("CategoryLandingSections", fields: [categoryId], references: [id], onDelete: Cascade)
  layout      ContentLayout
  eyebrow     String?
  title       String
  description String?
  ctaLabel    String?
  ctaUrl      String?
  mediaType   ContentMediaType @default(IMAGE)
  imageUrl    String?
  videoUrl    String?
  // TILES / BENTO only: [{ title, imageUrl, url }]
  items       Json?

  // PRODUCTS only
  productSource    ContentProductSource?
  sourceCategoryId String?
  sourceCategory   Category?             @relation("ContentSectionSourceCategory", fields: [sourceCategoryId], references: [id], onDelete: SetNull)
  sourceBrandId    String?
  sourceBrand      Brand?                @relation(fields: [sourceBrandId], references: [id], onDelete: SetNull)
  productLimit     Int                   @default(12)

  position  Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([page, categoryId, active, position])
}

model FilterType {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  // Editorial image for this theme's card on the Shop By page.
  imageUrl String?
  tags     Tag[]
}

model Tag {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  filterTypeId String
  filterType   FilterType   @relation(fields: [filterTypeId], references: [id])
  products     ProductTag[]
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id])
  tag       Tag     @relation(fields: [tagId], references: [id])

  @@id([productId, tagId])
  @@index([tagId])
}

model Product {
  id              String            @id
  name            String
  description     String
  basePrice       Float
  discountPercent Float?
  createdAt       DateTime          @default(now())
  imageUrl        String?
  // Photos of someone wearing the product — shown on hover instead of the
  // main product photo. Product-level (not per-variant/colour) since these
  // are general "here's how it looks worn" shots, not tied to one colour.
  modelImages     String[]          @default([])
  // Editorial pick, toggled by hand — unlike "new," this is a deliberate
  // curatorial call, so it stays a plain flag rather than a tree membership.
  featured        Boolean           @default(false)
  archived        Boolean           @default(false)
  brandId         String
  brand           Brand             @relation(fields: [brandId], references: [id])
  categories      ProductCategory[]
  variants        Variant[]
  tags            ProductTag[]
  wishlists       Wishlist[]

  @@index([brandId])
}

model Variant {
  id              String          @id
  color           String
  size            String
  stock           Int             @default(10)
  sku             String          @unique
  images          String[]
  productId       String
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  waitlistEntries WaitlistEntry[]

  @@index([productId])
}

enum Role {
  CUSTOMER
  ADMIN
  // Staff roles, beyond CUSTOMER/ADMIN. Enforced server-side by
  // requireRole()/requireAdmin() — never by hiding a button client-side.
  OWNER
  SUPPORT
  FULFILMENT
  ANALYST
}

// A case is either a refund request or a general complaint — REFUND_REQUEST
// maps to the REFUND category, everything else to COMPLAINT. Kept as two
// enums (type + derived category) rather than one, so the admin UI can
// split "Refund Requests" from "Other Complaints" with a single filter.
enum CaseType {
  REFUND_REQUEST
  WRONG_ITEM
  MISSING_ITEM
  DAMAGED_ITEM
  ITEM_NOT_AS_DESCRIBED
  PACKAGE_NOT_RECEIVED
  DELIVERY_ISSUE
  PAYMENT_ISSUE
  OTHER
}

enum CaseCategory {
  REFUND
  COMPLAINT
}

enum CaseStatus {
  SUBMITTED
  UNDER_REVIEW
  AWAITING_CUSTOMER_INFO
  APPROVED
  REJECTED
  REFUND_PROCESSING
  REFUNDED
  REFUND_FAILED
  RESOLVED
  CLOSED
}

// A customer-submitted refund request or complaint. `dedupeKey` is a hash of
// (userId, orderId, issueType, description) — its unique constraint is what
// stops a double form-submit or a network retry from creating two cases for
// the same thing, without having to guess at a time window.
model SupportCase {
  id                     String       @id @default(cuid())
  reference              String       @unique
  userId                 String       @db.Uuid
  user                   User         @relation(fields: [userId], references: [id])
  customerEmail          String
  orderId                String?
  order                  Order?       @relation(fields: [orderId], references: [id])
  orderItemIds           String[]     @default([])
  paystackReference      String?
  issueType              CaseType
  category               CaseCategory
  description            String
  requestedRefundAmount  Float?
  evidenceUrls           String[]     @default([])
  status                 CaseStatus   @default(SUBMITTED)
  dedupeKey              String       @unique

  // Refund execution state — only meaningful once an admin approves a
  // REFUND case. `refundedAmount` is set only after Paystack confirms the
  // refund actually completed, never merely because an admin clicked
  // approve.
  refundReference String?
  refundedAmount  Float?
  refundedAt      DateTime?

  notes     CaseNote[]
  events    CaseEvent[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([category])
}

// Internal admin-only notes on a case — never shown to the customer.
model CaseNote {
  id        String      @id @default(cuid())
  caseId    String
  case      SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId  String      @db.Uuid
  author    User        @relation(fields: [authorId], references: [id])
  note      String
  createdAt DateTime    @default(now())

  @@index([caseId, createdAt])
}

// Status-change history for a case — "view case history" in the admin UI.
model CaseEvent {
  id         String       @id @default(cuid())
  caseId     String
  case       SupportCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  fromStatus CaseStatus?
  toStatus   CaseStatus
  actorId    String?      @db.Uuid
  actor      User?        @relation(fields: [actorId], references: [id])
  note       String?
  createdAt  DateTime     @default(now())

  @@index([caseId, createdAt])
}

// Lightweight audit trail for sensitive admin actions (refund decisions,
// complaint/order status changes, role changes). Deliberately a flat log,
// not event sourcing — nothing reads it back into application state.
model AdminAuditLog {
  id            String   @id @default(cuid())
  actorId       String   @db.Uuid
  actor         User     @relation(fields: [actorId], references: [id])
  action        String
  entityType    String
  entityId      String
  previousState Json?
  newState      Json?
  createdAt     DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
